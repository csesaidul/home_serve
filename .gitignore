# Environment files (never commit real secrets)
.env
*.env
!*.env.example

# Python / FastAPI backend
__pycache__/
*.py[cod]
*.pyo
*.pyd
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.sqlite3
*.db

# Backup / scratch files
*copy*.py
*.bak
*.orig
*.tmp
*.temp

# Uploaded user content
backend/uploads/*
!backend/uploads/.gitkeep

# Flutter frontend
hove_serve_app/.dart_tool/
hove_serve_app/.flutter-plugins
hove_serve_app/.flutter-plugins-dependencies
hove_serve_app/.pub-cache/
hove_serve_app/.pub/
hove_serve_app/build/
hove_serve_app/coverage/
hove_serve_app/android/app/debug/
hove_serve_app/android/app/profile/
hove_serve_app/android/app/release/
hove_serve_app/ios/Flutter/.last_build_id
hove_serve_app/**/doc/api/

